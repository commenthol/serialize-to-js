{
  "name": "serialize-to-js",
  "version": "3.2.0",
  "description": "serialize objects to javascript",
  "keywords": [
    "javascript",
    "objects",
    "serialize"
  ],
  "homepage": "https://github.com/commenthol/serialize-to-js",
  "bugs": {
    "url": "https://github.com/commenthol/serialize-to-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commenthol/serialize-to-js.git"
  },
  "license": "MIT",
  "author": "commenthol <commenthol@gmail.com>",
  "maintainers": "commenthol <commenthol@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "main": "./lib/index.cjs",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "directories": {
    "test": "test"
  },
  "files": [
    "lib",
    "src",
    "types/index.d.ts",
    "types/index.d.cts"
  ],
  "scripts": {
    "build": "rollup src/index.js --file lib/index.cjs --format cjs",
    "ci": "npm run clean && npm run lint && npm test && npm run types",
    "clean": "rimraf lib doc types/index.d.ts types/internal coverage .nyc_output *.tgz",
    "coverage": "nyc -r text -r html npm test",
    "format": "prettier --write eslint.config.js \"src/**/*.js\"",
    "lint": "eslint src test",
    "prepack": "npm run build && npm run types",
    "test": "npm run build && mocha",
    "types": "tsc -p tsconfig.json"
  },
  "mocha": {
    "check-leaks": true
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.8",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=12.17.0"
  }
}
