{
  "name": "serialize-to-js",
  "version": "3.2.0",
  "description": "serialize objects to javascript",
  "keywords": [
    "javascript",
    "objects",
    "serialize"
  ],
  "homepage": "https://github.com/commenthol/serialize-to-js",
  "bugs": {
    "url": "https://github.com/commenthol/serialize-to-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commenthol/serialize-to-js.git"
  },
  "license": "MIT",
  "author": "commenthol <commenthol@gmail.com>",
  "maintainers": "commenthol <commenthol@gmail.com>",
  "main": "src",
  "directories": {
    "test": "test"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "ci": "npm run clean && npm run lint && npm test",
    "clean": "rimraf lib doc coverage .nyc_output *.tgz",
    "coverage": "nyc -r text -r html npm test",
    "lint": "eslint src test",
    "format": "prettier --write eslint.config.js \"src/**/*.js\"",
    "test": "mocha"
  },
  "mocha": {
    "check-leaks": true
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4"
  },
  "engines": {
    "node": ">=4.0.0"
  }
}
